# Opslag: "airtable" of "console" (standaard console)
STORAGE_ADAPTER=console
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=Aanvragen

# E-mailmelding via Resend
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=Robotempo <aanvragen@robotempo.com>

# Analytics (Plausible, zonder cookies)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Volledige URL van de site, voor Open Graph
NEXT_PUBLIC_SITE_URL=https://robotempo.com
